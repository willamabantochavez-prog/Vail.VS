local function walkSpeed()
    local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid"); local spd = h and h.WalkSpeed or 16
    local ok2, res = pcall(function()
        local stat = LP:FindFirstChild("leaderstats"); stat = stat and stat:FindFirstChild("Speed")
        local util = require(RS.Shared.Util.TreadmillUtil)
        return stat and util.SpeedPowerToWalkSpeed(stat.Value) or nil
    end)
    if ok2 and type(res) == "number" and res > 0 then spd = math.min(spd, res) end
    return spd
