local function grab(uid, timeout)
    local cache = { At = 0 }; local waited, since = 0, 1
    while not state.Carrying and waited < timeout and not state.Cancel do
        local r = gRoot(); local egg = eggNow(uid, cache); local dt = math.max(RN.Heartbeat:Wait(), 1 / 240)
        waited = waited + dt; since = since + dt
        if r and egg then
            local delta = egg - r.Position
            if delta.Magnitude > 2 then
                local pace = math.max(walkSpeed() * FC.SpeedCap, 16); local v = delta / math.max(0.08, dt); if v.Magnitude > pace then v = v.Unit * pace end
                pcall(function() r.AssemblyLinearVelocity = v + Vector3.new(0, workspace.Gravity * dt * 0.5, 0); r.AssemblyAngularVelocity = Vector3.zero end)
            end
            if since >= FC.GrabInterval then
                since = 0; local pr = promptNear(egg - Vector3.new(0, 3, 0), 10)
                if pr and typeof(fireproximityprompt) == "function" then pcall(function() pr.HoldDuration = 0 end); pcall(fireproximityprompt, pr) end
                task.spawn(takeEgg, uid)
            end
        elseif since >= FC.GrabInterval then since = 0; task.spawn(takeEgg, uid) end
    end
    local r = gRoot(); if r then pcall(function() r.AssemblyLinearVelocity = Vector3.zero end) end
    return state.Carrying and state.Uid == uid
end

local function regrab(uid)
    if state.Carrying then return true end
    local r = gRoot(); local egg = eggPosition(uid)
    if r and egg and Vector3.new(r.Position.X - egg.X, 0, r.Position.Z - egg.Z).Magnitude > FC.RegrabFar then place(egg + Vector3.new(0, 3, 0)) end
    return grab(uid, 3)
end

local function runToEgg(uid, egg)
    local lineX = lineInfo(); local home = homePoint()
    local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then h.PlatformStand = false; if c:FindFirstChildWhichIsA("Tool") then pcall(function() h:UnequipTools() end) end end
    local r = gRoot(); if not r then return false end
    local stage = "field"
    if r.Position.X < lineX - 2 and Vector3.new(r.Position.X - home.X, 0, r.Position.Z - home.Z).Magnitude > 20 then stage = "safe" end
    local started, lastChk, lastPos, lastTk = os.clock(), os.clock(), r.Position, 0
    while os.clock() - started < 120 and not state.Cancel do
        r = gRoot(); if not r then return false end
        local flatEgg = Vector3.new(egg.X - r.Position.X, 0, egg.Z - r.Position.Z)
        if stage == "field" and flatEgg.Magnitude <= 2.5 then break end
        local target = egg
        if stage == "safe" then
            if Vector3.new(home.X - r.Position.X, 0, home.Z - r.Position.Z).Magnitude <= 6 then stage = "field" else target = home end
        end
        local flat = Vector3.new(target.X - r.Position.X, 0, target.Z - r.Position.Z)
        local unit = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
        local speed = math.max(walkSpeed() * FC.SpeedCap, 8); local v = unit * math.min(speed, flat.Magnitude / 0.05)
        pcall(function() r.AssemblyLinearVelocity = Vector3.new(v.X, r.AssemblyLinearVelocity.Y, v.Z); if h and unit.Magnitude > 0 then h:Move(unit, false) end end)
        if os.clock() - lastChk >= 1.5 then
            if (r.Position - lastPos).Magnitude < 3 and h and flatEgg.Magnitude > 15 then pcall(function() h.Jump = true end) end
            lastPos, lastChk = r.Position, os.clock()
        end
        if stage == "field" and flatEgg.Magnitude <= 9 and os.clock() - lastTk > 0.1 then lastTk = os.clock(); takeEgg(uid) end
        RN.Heartbeat:Wait()
    end
    r = gRoot()
    if r then pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, r.AssemblyLinearVelocity.Y, 0); if h then h:Move(Vector3.zero, false) end end) end
    return state.Carrying or (r ~= nil and Vector3.new(egg.X - r.Position.X, 0, egg.Z - r.Position.Z).Magnitude <= 6)
end

local function instantTP(uid)
    local started = os.clock(); local lineX, lineY = lineInfo()
    local r = gRoot(); if not r then return false end
    local laneZ = math.clamp(r.Position.Z, -425, -300)
    local landing = Vector3.new(lineX + FC.LandOffset, lineY + 3.35, laneZ)
    local hopStep = math.max(walkSpeed() * FC.HopRatio, FC.HopMin)
    local hopY = r.Position.Y + FC.HopLift; local x = r.Position.X; local retries = 0
    local relCam
    pcall(function()
        local cam = workspace.CurrentCamera; local ot = cam.CameraType; local fr = cam.CFrame
        cam.CameraType = Enum.CameraType.Scriptable; cam.CFrame = fr
        relCam = function() pcall(function() cam.CameraType = ot end) end
    end)
    if not relCam then relCam = function() end end
    while x - hopStep > landing.X and not state.Cancel do
        if not state.Carrying then
            if not regrab(uid) then break end; local cur = gRoot(); if cur then x = math.min(x, cur.Position.X) end
        else
            local nextX = x - hopStep; local pulledBefore = state.PulledAt; local held = 0
            while held < FC.HopGap do place(Vector3.new(nextX, hopY, laneZ)); held = held + RN.Heartbeat:Wait() end
            local chk = gRoot()
            local pulled = state.PulledAt > pulledBefore or (chk ~= nil and (chk.Position.X - nextX > 10 or chk.AssemblyLinearVelocity.Magnitude > 150))
            if pulled and state.Carrying and not state.Cancel then
                retries = retries + 1; FC.HopGap = math.min(FC.HopGapMax, FC.HopGap + 0.02)
                if retries > FC.HopRetries then break end
                local settle = 0; while settle < 0.12 and not state.Cancel do place(Vector3.new(x, hopY, laneZ)); settle = settle + RN.Heartbeat:Wait() end
            else x = nextX; FC.HopGap = math.max(FC.HopGapMin, FC.HopGap - 0.01) end
        end
    end
    landing = Vector3.new(landing.X, groundY(landing, landing.Y), landing.Z)
    local function doLand()
        local cur = gRoot()
        if cur and cur.Position.X <= landing.X + 1 and cur.Position.Y > landing.Y - 25 then pcall(function() cur.AssemblyLinearVelocity = Vector3.zero end); return end
        place(landing)
    end
    doLand()
    for attempt = 1, 3 do
        local settle = 0; while settle < FC.LandSettle and not state.Cancel do settle = settle + RN.Heartbeat:Wait() end
        local landed = gRoot(); if state.Carrying and landed and (landed.Position.X - landing.X > 12 or landed.Position.Y < landing.Y - 25) then doLand() else break end
    end
    if state.Carrying and not state.Cancel then
        local dl = 0; while dl < FC.DropDelay do dl = dl + RN.Heartbeat:Wait() end; dropEgg()
        local w = 0; while state.Carrying and w < 1 and not state.Cancel do w = w + RN.Heartbeat:Wait() end
        local cur = gRoot(); if cur then pcall(function() cur.AssemblyLinearVelocity = Vector3.zero; cur.AssemblyAngularVelocity = Vector3.zero end) end
        pcall(relCam); if not grab(uid, 3) and not regrab(uid) then return false end
    end
    pcall(relCam)
    if state.Carrying then
        local home = homePoint(); local height = FC.Height; local share = math.clamp(FC.ClimbShare, 0.1, 0.9)
        local descent = height * math.sqrt(1 - share * share) / share
        local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid"); if h then h.PlatformStand = false end
        r = gRoot()
        if r and c and height > 0.5 and home.Y + height - 2 > r.Position.Y then
            pcall(function() c:PivotTo(CFrame.new(Vector3.new(r.Position.X, home.Y + height, r.Position.Z)) * r.CFrame.Rotation); r.AssemblyLinearVelocity = Vector3.zero; r.AssemblyAngularVelocity = Vector3.zero end)
        end
        local startR = gRoot()
        local speed = carrySpeed(startR and (Vector3.new(startR.Position.X - home.X, 0, startR.Position.Z - home.Z).Magnitude + math.max(0, height) * 2) or nil)
        local checkpoint = lineX - 7; local last = os.clock(); local timeout = 0
        while state.Carrying and state.Delivered < started and not state.Cancel and timeout < 25 do
            r = gRoot(); if not r then break end
            local now = os.clock(); local dt = math.max(now - last, 1 / 240); last = now; timeout = timeout + dt
            local toH = r.Position.X <= checkpoint + 2; local target = toH and home or Vector3.new(checkpoint, home.Y, laneZ)
            if toH and Vector3.new(home.X - r.Position.X, 0, home.Z - r.Position.Z).Magnitude < 2 then break end
            local flat = Vector3.new(target.X - r.Position.X, 0, target.Z - r.Position.Z)
            local remaining = toH and 0 or math.max(0, r.Position.X - checkpoint)
            local wantY = home.Y + height
            if toH or remaining <= descent then wantY = home.Y + height * math.clamp(remaining / math.max(descent, 1), 0, 1) end
            local vy = math.clamp((wantY - r.Position.Y) / 0.12, -speed * share, speed * share)
            local horiz = math.sqrt(math.max(speed * speed - vy * vy, 0))
            local v = flat.Magnitude > 0.01 and flat.Unit * math.min(horiz, flat.Magnitude / 0.05) or Vector3.zero
            pcall(function() r.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z) end)
            RN.Heartbeat:Wait()
        end
        if h then pcall(function() h:Move(Vector3.zero, false) end) end
        local settle = 0; while settle < 2 and state.Delivered < started and state.Carrying and not state.Cancel do settle = settle + RN.Heartbeat:Wait() end
        if state.Carrying and state.Delivered < started and not state.Cancel then
            task.wait(0.2); dropEgg(); local w = 0; while state.Delivered < started and w < 1 do w = w + RN.Heartbeat:Wait() end
        end
    end
    return state.Delivered >= started
end

