local function snapshot()
    local list = {}
    local ok2, result = pcall(function() return getRemote("RF/EggWorld/AskFieldEggSnapshot"):InvokeServer() end)
    local records = ok2 and type(result) == "table" and result.Records or nil
    if type(records) ~= "table" then return list end
    for _, r in pairs(records) do
        if type(r) == "table" and type(r.Uid) == "string" and (r.State == "Slot" or r.State == "Dropped") and typeof(r.BottomCFrame) == "CFrame" then
            list[#list + 1] = r
        end
    end
    return list
end

local function eggPosition(uid) for _, r in ipairs(snapshot()) do if r.Uid == uid then return r.BottomCFrame.Position end end return nil end

local function describe(record)
    local directory = type(Assets) == "table" and Assets.Directory or nil
    local entry = type(directory) == "table" and directory[tostring(record.AssetCategory)] or nil
    local info = { Uid = record.Uid, Name = tostring(record.AssetCategory), Icon = "", Rarity = 0, Value = 0 }
    if type(entry) == "table" then
        info.Name = tostring(entry.DisplayName or record.AssetCategory)
        local icon = entry.Icon
        if icon ~= nil and tostring(icon) ~= "" then icon = tostring(icon); info.Icon = tonumber(icon) and ("rbxassetid://" .. icon) or icon end
        if type(entry.Rarity) == "table" then info.Rarity = tonumber(entry.Rarity.RarityNumber or entry.Rarity.Rank) or 0 end
        local scale = tonumber(record.AssetScale) or 1
        local factor = scale > 5 and (scale / 5) ^ 1.2 * 19.637875755794113 or scale ^ 1.85
        local mutation = 1
        if type(Mutations) == "table" and type(Mutations.EarningsFor) == "function" then
            local om, rm = pcall(Mutations.EarningsFor, type(record.Mutations) == "table" and record.Mutations or {})
            if om and type(rm) == "number" then mutation = rm end
        end
        info.Value = (tonumber(entry.EarningRate) or 0) * factor * mutation
    end
    return info
end

local function money(v)
    local u = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
    for _, p in ipairs(u) do if v >= p[1] then return string.format("$%.2f%s/s", v / p[1], p[2]) end end
    return string.format("$%d/s", math.floor(v + 0.5))
end

