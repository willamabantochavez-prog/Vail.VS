    node = node or (slots and slots:FindFirstChild(uid))
    if node then
        local o, pos = pcall(function() return node:GetPivot().Position end)
        if o and pos then cache.Pos, cache.At = pos, os.clock() return pos end
    end
    if os.clock() - cache.At >= 0.5 then
        cache.At = os.clock() cache.Pos = eggPosition(uid) or cache.Pos
    end
    return cache.Pos
