local allParticles = {}

local function AddParticles(parent, count)
    local group = { Parent = parent, Data = {} }
    for i = 1, (count or 5) do
        local sz = math.random(16, 30)
        local img = Instance.new("ImageLabel")
        img.Image = "rbxassetid://112002576136361"
        img.BackgroundTransparency = 1
        img.Size = UDim2.fromOffset(sz, sz)
        img.Position = UDim2.new(math.random() * 85 / 100, 0, -math.random() * 25 / 100, 0)
        img.ImageTransparency = math.random(55, 78) / 100
        img.ImageColor3 = PCOLORS[math.random(1, #PCOLORS)]
        img.ZIndex = 3
        img.Rotation = math.random(0, 360)
        img.Parent = parent
        group.Data[i] = {
            Obj = img,
            Spd = 0.03 + math.random() * 0.065,
            Drift = (math.random() - 0.5) * 0.012,
            Rot = (math.random() - 0.5) * 1.8,
        }
    end
    table.insert(allParticles, group)
end

task.spawn(function()
    while true do
        task.wait(0.04)
        for i = #allParticles, 1, -1 do
            local g = allParticles[i]
            if not g.Parent or not g.Parent.Parent then
                table.remove(allParticles, i)
            else
                for _, p in ipairs(g.Data) do
                    local pos = p.Obj.Position
                    local ny = pos.Y.Scale + p.Spd
                    local nx = pos.X.Scale + p.Drift
                    if ny > 1.12 then
                        ny = -math.random(8, 30) / 100
                        nx = math.random() * 0.82
                        p.Obj.ImageTransparency = math.random(55, 78) / 100
                        p.Obj.ImageColor3 = PCOLORS[math.random(1, #PCOLORS)]
                    end
                    if nx > 1.08 then nx = -0.08 elseif nx < -0.08 then nx = 1.08 end
                    p.Obj.Position = UDim2.new(nx, 0, ny, 0)
                    p.Obj.Rotation = p.Obj.Rotation + p.Rot
                end
            end
        end
    end
end)

