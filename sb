    local e = workspace:FindFirstChild(uid); if not e then return false end
    for _, d in ipairs(e:GetDescendants()) do
        if d:IsA("WeldConstraint") or d:IsA("JointInstance") then
            local ok2, a, b = pcall(function() return d.Part0, d.Part1 end)
            if ok2 and ((a and a:IsDescendantOf(c)) or (b and b:IsDescendantOf(c))) then return true end
        end
    end
    return false
end

